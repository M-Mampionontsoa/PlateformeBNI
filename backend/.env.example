# =========================================================
# Base de donnees (obligatoire)
# =========================================================
# Variables separees recommandees : les caracteres speciaux du mot de
# passe (@, #, /, %...) sont encodes automatiquement, pas besoin d'y toucher.
DB_USER=dw_user
DB_PASSWORD=dw_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dw_mvp

# Alternative : une URL complete deja construite (decommentez et adaptez).
# Si vous utilisez cette option, encodez vous-meme les caracteres speciaux
# du mot de passe (@ -> %40, # -> %23, etc.)
# DATABASE_URL=mysql+pymysql://dw_user:dw_password@localhost:3306/dw_mvp

# =========================================================
# Authentification (recommande)
# =========================================================
# Cle utilisee pour signer les JWT. Une valeur de dev est utilisee si absente,
# mais definissez-la vous-meme des que l'app quitte votre poste.
SECRET_KEY=change-moi-en-une-longue-chaine-aleatoire

# Cle de session (utilisee par le flux Google OAuth). Meme remarque.
SESSION_SECRET_KEY=change-moi-aussi

# =========================================================
# Frontend / Backend (recommande)
# =========================================================
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# =========================================================
# Email / SMTP (optionnel)
# Sans ces variables, l'inscription fonctionne normalement mais l'email
# de verification n'est pas envoye - le lien est simplement affiche dans
# les logs du serveur, pratique pour le dev local.
# =========================================================
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.mg
MAIL_FROM_NAME=Plateforme BNI
MAIL_PORT=587
MAIL_SERVER=

# =========================================================
# Google OAuth (optionnel)
# Sans ces variables, la connexion classique (email/mot de passe)
# fonctionne normalement, mais le bouton "Continuer avec Google" echoue.
# =========================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
